return {
  'nvim-neorg/neorg',
  lazy = false,
  version = '^7.0.0',
  dependencies = {
    'nvim-treesitter/nvim-treesitter',
  },
  run = ':Neorg sync-parsers',
  config = function()
    require('neorg').setup {
      load = {
        ['core.defaults'] = {},
        ['core.concealer'] = {},
        ['core.dirman'] = {
          config = {
            workspaces = {
              notes = '~/norg/notes',
            },
            default_workspace = 'notes',
          },
        },
      },
    }
  end,
}
